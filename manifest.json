{
  "manifest_version": 3,
  "name": "Click Sender for WhatsApp (manual)",
  "version": "0.1.0",
  "description": "A side panel to prepare personalised WhatsApp messages and open each chat with one click. You press Send yourself. Local and manual.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open Click Sender",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" }
}
